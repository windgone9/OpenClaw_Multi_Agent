# ============================================
# OpenClaw Multi-Agent 环境变量配置
# 复制此文件为 .env 并填入真实值
# cp .env.example .env
# ============================================

# ---------- API Keys（可选，使用远端模型时需要） ----------
# Moonshot (Kimi) API Key
# 申请地址: https://platform.moonshot.cn/console/api-keys
MOONSHOT_API_KEY=

# DeepSeek API Key
# 申请地址: https://platform.deepseek.cn/api_keys
DEEPSEEK_API_KEY=

# OpenClaw Gateway Token（如需认证）
OPENCLAW_TOKEN=

# OpenClaw API Key（Python 调度器使用）
OPENCLAW_API_KEY=

# ---------- 服务端口（可选，默认值已标注） ----------
# Custom Gateway
GATEWAY_PORT=3000
GATEWAY_HOST=0.0.0.0

# Bridge 智能路由层
BRIDGE_PORT=3001

# Python 调度器
SCHEDULER_HOST=0.0.0.0
SCHEDULER_PORT=8000
SCHEDULER_LOG_LEVEL=INFO

# ---------- Gateway 连接（可选） ----------
# Custom Gateway 地址
OPENCLAW_GATEWAY_URL=http://localhost:3000

# OpenClaw 官方 Gateway 地址
OPENCLAW_OFFICIAL_GATEWAY_URL=http://127.0.0.1:3005

# 是否启用 Gateway 路由（true/false）
USE_OPENCLAW_GATEWAY=true

# ---------- Smart Router（可选） ----------
# 默认路由模式: smart / gateway / agent / hermes
DEFAULT_ROUTE_MODE=smart

# Smart Router 复杂度阈值（0-100，>= 阈值走 Agent）
SMART_ROUTER_THRESHOLD=40

# Agent 执行超时（毫秒）
AGENT_EXECUTION_TIMEOUT=120000

# ---------- Hermes 智能路由（可选） ----------
# Hermes 服务端口
HERMES_PORT=8082

# Hermes 连接的 Bridge 地址
HERMES_BRIDGE_URL=http://localhost:3001

# Hermes 连接的 Python 调度器地址
HERMES_SCHEDULER_URL=http://localhost:8000

# Hermes 复杂度阈值（0-100，>= 阈值走 Agent Chain）
HERMES_COMPLEXITY_THRESHOLD=40

# Hermes 探索率（0-1，尝试新路径的概率）
HERMES_EXPLORATION_RATE=0.1

# Hermes 记忆数据库路径
HERMES_DB_PATH=

# Hermes GEPA 自进化算法开关
HERMES_GEPA_ENABLED=true

# ---------- 限流与重试（可选） ----------
# 全局限流 RPM
RATE_LIMIT_RPM=60

# 单 AppID 限流 RPM
RATE_LIMIT_PER_APPID=30

# 最大重试次数
MAX_RETRIES=2

# 默认超时（毫秒）
DEFAULT_TIMEOUT_MS=30000

# ============================================
# 服务器部署变量 (feature_deploytoTestServer)
# 本机开发不用; 部署到测试服务器 (vLLM) 时由 K8S 清单/secret 注入。
# 详见 k8s/server/server.env.example 与 docs/SERVER_DEPLOY.md
# ============================================
# vLLM 推理端点 (集群内 DNS, 由 13-inference-endpoints.yaml 定义)
# TEXT_INFERENCE_API_BASE=http://text-inference:8000/v1
# VISION_INFERENCE_API_BASE=http://vision-inference:8000/v1
# vLLM 鉴权 (默认 EMPTY; 服务器 vLLM 带 --api-key 时填, 经 secret vllm-api-key 注入)
# VLLM_API_KEY=EMPTY
# deepseek-r1 推理块剥离 (server proxy 清单默认 true)
# STRIP_REASONING_TAGS=true
# 镜像 registry 前缀 (多节点集群用, deploy-server.sh 读取)
# REGISTRY=

