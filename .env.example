# ============================================
# OpenClaw Multi-Agent 环境变量配置
# 复制此文件为 .env 并填入真实值
# cp .env.example .env
# ============================================

# ---------- API Keys（必填） ----------
# Moonshot (Kimi) API Key
# 申请地址: https://platform.moonshot.cn/console/api-keys
MOONSHOT_API_KEY=sk-C8QdZbmLHui8KjambKVZvwo7lTcWt4BROIus7N69l8eTCakz

# DeepSeek API Key
# 申请地址: https://platform.deepseek.cn/api_keys
DEEPSEEK_API_KEY=sk-7b716ef8d8ed4a25ae6f3d77c8c12ff4

# OpenClaw Gateway Token（如需认证）
OPENCLAW_TOKEN=

# OpenClaw API Key（Python 调度器使用）
OPENCLAW_API_KEY=

# ---------- 服务端口（可选，默认值已标注） ----------
# Custom Gateway
GATEWAY_PORT=3000
GATEWAY_HOST=0.0.0.0

# Bridge 智能路由层
BRIDGE_PORT=3001

# Python 调度器
SCHEDULER_HOST=0.0.0.0
SCHEDULER_PORT=8000
SCHEDULER_LOG_LEVEL=INFO

# ---------- Gateway 连接（可选） ----------
# Custom Gateway 地址
OPENCLAW_GATEWAY_URL=http://localhost:3000

# OpenClaw 官方 Gateway 地址
OPENCLAW_OFFICIAL_GATEWAY_URL=http://127.0.0.1:3005

# 是否启用 Gateway 路由（true/false）
USE_OPENCLAW_GATEWAY=true

# ---------- Smart Router（可选） ----------
# 默认路由模式: smart / gateway / agent / hermes
DEFAULT_ROUTE_MODE=smart

# Smart Router 复杂度阈值（0-100，>= 阈值走 Agent）
SMART_ROUTER_THRESHOLD=40

# Agent 执行超时（毫秒）
AGENT_EXECUTION_TIMEOUT=120000

# ---------- Hermes 智能路由（可选） ----------
# Hermes 服务端口
HERMES_PORT=8082

# Hermes 连接的 Bridge 地址
HERMES_BRIDGE_URL=http://localhost:3001

# Hermes 连接的 Python 调度器地址
HERMES_SCHEDULER_URL=http://localhost:8000

# Hermes 复杂度阈值（0-100，>= 阈值走 Agent Chain）
HERMES_COMPLEXITY_THRESHOLD=40

# Hermes 探索率（0-1，尝试新路径的概率）
HERMES_EXPLORATION_RATE=0.1

# Hermes 记忆数据库路径
HERMES_DB_PATH=

# Hermes GEPA 自进化算法开关
HERMES_GEPA_ENABLED=true

# ---------- 限流与重试（可选） ----------
# 全局限流 RPM
RATE_LIMIT_RPM=60

# 单 AppID 限流 RPM
RATE_LIMIT_PER_APPID=30

# 最大重试次数
MAX_RETRIES=2

# 默认超时（毫秒）
DEFAULT_TIMEOUT_MS=30000
