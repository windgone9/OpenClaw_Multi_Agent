FROM ghcr.io/berriai/litellm:main-latest

# LiteLLM 需要 Pillow 来将 base64 图片转换为 Ollama 格式
RUN /app/.venv/bin/python3 -c "import subprocess,sys; \
    subprocess.check_call([sys.executable,'-m','ensurepip','--upgrade'],stdout=subprocess.DEVNULL); \
    subprocess.check_call([sys.executable,'-m','pip','install','--no-cache-dir','Pillow'],stdout=subprocess.DEVNULL)"
