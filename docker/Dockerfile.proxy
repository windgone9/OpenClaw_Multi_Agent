FROM python:3.11-slim

WORKDIR /app

# 安装系统依赖
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*

# 安装 Python 依赖（使用清华 pip 镜像，增加重试）
RUN pip install --upgrade pip -i https://pypi.tuna.tsinghua.edu.cn/simple && \
    pip install --no-cache-dir --retries 5 --timeout 120 \
    -i https://pypi.tuna.tsinghua.edu.cn/simple \
    fastapi uvicorn httpx pydantic python-dotenv psutil \
    PyMuPDF python-docx minio python-multipart

# 复制项目代码
COPY hermes ./hermes
COPY .hermes ./.hermes
COPY static ./static

EXPOSE 4000

HEALTHCHECK --interval=15s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:4000/health || exit 1

CMD ["python", "-m", "hermes.litellm_proxy"]
