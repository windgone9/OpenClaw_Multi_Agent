# ============================================
# 服务器部署环境变量 (feature_deploytoTestServer)
# 这些值不在 .env (本机开发用), 而是服务器 K8S 部署时由清单/secret 注入。
# 此文件仅文档化各变量含义与默认值, 供 deploy-server.sh 与排错参考。
# ============================================

# ---- vLLM 推理端点 (GPUStack 托管, 集群外) ----
# 方案A: vLLM 由 GPUStack 部署于 http://192.168.0.151 (集群外), litellm 直连。
# api_base 在 02-litellm-config-server.yaml 里固定为 http://192.168.0.151/v1;
# 若 GPUStack 地址/端口变更, 改该 configmap 的 api_base (4 处)。
TEXT_INFERENCE_API_BASE=http://192.168.0.151/v1
VISION_INFERENCE_API_BASE=http://192.168.0.151/v1

# ---- vLLM 鉴权 (GPUStack API key) ----
# ★ 必填: GPUStack http://192.168.0.151/ 的 API key。
# 经 VLLM_API_KEY 环境变量传给 deploy-server.sh, 写入 K8S secret (不落 git)。
# litellm 经 VLLM_API_KEY env 读取 (02 config 里 api_key: os.environ/VLLM_API_KEY)。
VLLM_API_KEY=gpustack_xxx

# ---- 推理模型内容处理 ----
# deepseek-r1-distill 是推理模型, 输出可能含 think 块。
# proxy 置 true 时从 content 剥离 think 块 (server 清单默认 true)。
STRIP_REASONING_TAGS=true

# ---- 镜像分发 (多节点集群) ----
# 单节点: 留空, 镜像 build 在节点上, imagePullPolicy=IfNotPresent 即可。
# 多节点: 填 registry 前缀 (含末尾 /), deploy-server.sh 会 retag+push。
# 例: REGISTRY=registry.example.com/openclaw-
REGISTRY=

# ---- LiteLLM Master Key (默认与本机一致, 生产环境请改) ----
LITELLM_MASTER_KEY=sk-litellm-local

# ---- MinIO (服务器默认与本机一致, 生产请改密码) ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
