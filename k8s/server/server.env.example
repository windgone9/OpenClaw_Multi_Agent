# ============================================
# 服务器部署环境变量 (feature_deploytoTestServer)
# 这些值不在 .env (本机开发用), 而是服务器 K8S 部署时由清单/secret 注入。
# 此文件仅文档化各变量含义与默认值, 供 deploy-server.sh 与排错参考。
# ============================================

# ---- vLLM 推理端点 (服务器已部署, 集群内可达) ----
# 填入 13-inference-endpoints.yaml 的 Endpoints subsets IP 即可,
# api_base 在 litellm 配置里固定为 http://<svc>:8000/v1。
# 若 vLLM 端口非 8000, 同步改 13-inference-endpoints.yaml 的 port 和 litellm api_base。
TEXT_INFERENCE_API_BASE=http://text-inference:8000/v1
VISION_INFERENCE_API_BASE=http://vision-inference:8000/v1

# ---- vLLM 鉴权 ----
# vLLM 默认不鉴权; 若服务器 vLLM 启动带 --api-key, 把 key 填进
# k8s/01-secrets.yaml 的 vllm-api-key (litellm 经 VLLM_API_KEY env 读取)。
VLLM_API_KEY=EMPTY

# ---- 推理模型内容处理 ----
# deepseek-r1-distill 是推理模型, 输出可能含 think 块。
# proxy 置 true 时从 content 剥离 think 块 (server 清单默认 true)。
STRIP_REASONING_TAGS=true

# ---- 镜像分发 (多节点集群) ----
# 单节点: 留空, 镜像 build 在节点上, imagePullPolicy=IfNotPresent 即可。
# 多节点: 填 registry 前缀 (含末尾 /), deploy-server.sh 会 retag+push。
# 例: REGISTRY=registry.example.com/openclaw-
REGISTRY=

# ---- LiteLLM Master Key (默认与本机一致, 生产环境请改) ----
LITELLM_MASTER_KEY=sk-litellm-local

# ---- MinIO (服务器默认与本机一致, 生产请改密码) ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
