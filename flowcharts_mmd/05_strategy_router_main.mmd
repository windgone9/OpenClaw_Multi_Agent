    A2 -->|LATENCY_OPTIMIZED| A6[_route_latency_optimized]
    A2 -->|COST_OPTIMIZED| A7[_route_cost_optimized]
    A2 -->|CAPABILITY_OPTIMIZED| A8[_route_capability_optimized]
    A2 -->|默认| A9[_route_default]

    A3 --> R[RoutingDecision]
    A4 --> R
    A5 --> R
    A6 --> R
    A7 --> R
    A8 --> R
    A9 --> R
